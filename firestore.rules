rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDeveloperGoogleAccount() {
      return request.auth != null
        && request.auth.token.email == "pascualpatrick264@gmail.com"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isPortfolioAdmin(appId) {
      return isDeveloperGoogleAccount()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/portfolios/patrick_pascual_meta)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/portfolios/patrick_pascual_meta).data.adminUid == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/portfolios/{portfolioId} {
      allow read: if portfolioId != "patrick_pascual_meta";
      allow write: if portfolioId != "patrick_pascual_meta" && isPortfolioAdmin(appId);
    }

    match /artifacts/{appId}/public/data/portfolios/patrick_pascual_meta {
      allow read: if request.auth != null;
      allow create: if isDeveloperGoogleAccount()
        && !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/portfolios/patrick_pascual_meta)
        && request.resource.data.keys().hasOnly(["adminUid", "adminEmail", "claimedAt"])
        && request.resource.data.keys().hasAll(["adminUid", "adminEmail", "claimedAt"])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.claimedAt is string;
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/contactMessages/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.keys().hasAll(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isPortfolioAdmin(appId);
    }
  }
}
